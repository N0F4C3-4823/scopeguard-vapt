SCOPEGUARD_HOST=127.0.0.1
SCOPEGUARD_PORT=8000
SCOPEGUARD_DATA_DIR=./data
SCOPEGUARD_MAX_CIDR_HOSTS=256
SCOPEGUARD_MAX_WORKERS=1
# Live assessment timing. These are independent from fixture-test timing.
SCOPEGUARD_LIVE_COMMAND_TIMEOUT=45
SCOPEGUARD_LIVE_LIMITED_COMMAND_TIMEOUT=45
SCOPEGUARD_SCANNER_HOST_TIMEOUT=30
SCOPEGUARD_SCANNER_COMMAND_GRACE=15
SCOPEGUARD_SCANNER_MAX_RETRIES=2
SCOPEGUARD_TCP_CONNECT_TIMEOUT=5
SCOPEGUARD_PROTOCOL_TIMEOUT=15
SCOPEGUARD_NMAP_SCRIPT_TIMEOUT=30
SCOPEGUARD_ASSESSMENT_DEADLINE=3600
SCOPEGUARD_OLLAMA_URL=http://127.0.0.1:11434
SCOPEGUARD_OLLAMA_MODEL=qwen2.5:1.5b-instruct
# Optional override; installer/start.sh choose cpu_avx2 when supported,
# otherwise the portable CPU library.
# SCOPEGUARD_OLLAMA_LLM_LIBRARY=cpu_avx2
# The installer prefers this project-local runtime when present.
SCOPEGUARD_OLLAMA_BIN=./.tools/ollama/bin/ollama
OLLAMA_MODELS=./data/ollama
# The normal interactive installer asks before making system changes and
# completes Ollama/Qwen setup. Use limited mode only when local AI is
# intentionally unavailable.
SCOPEGUARD_INSTALL_SYSTEM_PACKAGES=0
SCOPEGUARD_INSTALL_OLLAMA=1
SCOPEGUARD_INSTALL_OLLAMA_MODEL=1
# SCOPEGUARD_LIMITED_MODE=1
