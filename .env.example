SCOPEGUARD_HOST=127.0.0.1
SCOPEGUARD_PORT=8000
SCOPEGUARD_DATA_DIR=./data
SCOPEGUARD_MAX_CIDR_HOSTS=256
SCOPEGUARD_MAX_WORKERS=1
SCOPEGUARD_OLLAMA_URL=http://127.0.0.1:11434
SCOPEGUARD_OLLAMA_MODEL=qwen2.5:1.5b-instruct
